#!/usr/bin/env bash
#MISE description="Install missing native Hamlib/Qt dependencies with Homebrew"
#MISE hide=true
set -euo pipefail
command -v brew >/dev/null || { echo 'Install Homebrew and Xcode Command Line Tools first' >&2; exit 1; }
for formula in hamlib qt; do
  if ! brew list --versions "$formula" >/dev/null 2>&1; then
    brew install "$formula"
  fi
done
